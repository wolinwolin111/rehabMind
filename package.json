{
  "name": "rehabmind-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/run-python.mjs scripts/generate_knowledge.py",
    "assets": "node scripts/run-python.mjs scripts/prepare_3d.py && node scripts/authoring/prepare_model_display.mjs",
    "predev": "npm run data && npm run assets",
    "dev": "vite --host 0.0.0.0",
    "api": "node api/server.mjs",
    "audit": "node scripts/run-python.mjs scripts/authoring/read_database_audit.py && node scripts/authoring/audit_treatment_coverage.mjs --report-only",
    "pretest": "npm run data && npm run assets && npm run audit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run data && npm run assets && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.159.0",
    "three-mesh-bvh": "0.7.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.159.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
